# === Supabase Database ===
# Get these from your Supabase project settings
DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres
# Apply the auth user-mapping columns with: pnpm --filter @workspace/db push

# === Supabase Auth ===
# The URL and anon key are safe for the browser; the Vite config only exposes these two values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never add this key to a VITE_ variable or client-side code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === API Server ===
NODE_ENV=production
PORT=3000

# === Frontend ===
BASE_PATH=/
VITE_API_URL=https://your-domain.vercel.app/api

# === Creator Dashboard ===
CREATOR_PASSWORD=cristina2024
CREATOR_TOKEN=cristina-creator-session-token-secure
JWT_SECRET=your-jwt-secret-key-change-in-production

# === Email Configuration ===
EMAIL_USER=dogtrainer_cristina@outlook.com
EMAIL_PASSWORD=your-app-password-here
APP_URL=http://localhost:5173

# === Stripe (for payments) ===
VITE_STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_test_...
